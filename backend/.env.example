# Copy to .env and export (or use your process manager). Never commit the real file.
COINSPROUT_ENV=dev                 # dev | prod
DATABASE_URL=sqlite:///./coinsprout.db
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_API_KEY=change-me-too
OTP_PEPPER=another-long-random-string
STK_CALLBACK_SECRET=random-path-token-for-daraja-callback
PUBLIC_BASE_URL=https://your-public-host.example   # Daraja must reach /api/v1/stk/callback/<secret>
MPESA_PROVIDER=mock                # mock | daraja
# Daraja (only when MPESA_PROVIDER=daraja)
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
