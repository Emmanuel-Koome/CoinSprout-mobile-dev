<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Coarse is enough to rank nearby agents; fine location is deliberately NOT requested (data minimisation). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Only the "demo" flavour keeps this one. The "play" flavour strips it (src/play/AndroidManifest.xml). -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <application
        android:name=".CoinSproutApp"
        android:allowBackup="false"
        android:label="CoinSprout"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.CoinSprout">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CoinSprout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Only the system may deliver SMS_RECEIVED (BROADCAST_SMS), so other apps cannot forge broadcasts. -->
        <receiver
            android:name=".receiver.MpesaSmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
